#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


STATE_ROOT = Path("/var/lib/media-access-station/state")
MOUNT_ROOT = Path("/var/lib/media-access-station/devices")


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: mas-umount MOUNT_NAME")
    mount_name = sys.argv[1]
    target = MOUNT_ROOT / mount_name
    if not target.exists():
        raise SystemExit(f"Unknown mount target: {target}")

    mounted = subprocess.run(
        ["/usr/bin/findmnt", "-n", "--mountpoint", str(target)],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    if not mounted:
        state_path = STATE_ROOT / f"{mount_name}.json"
        state_path.unlink(missing_ok=True)
        print(json.dumps({
            "status": "already-unmounted",
            "mount_name": mount_name,
            "mount_path": str(target),
        }, ensure_ascii=False, indent=2))
        return

    subprocess.run(["/usr/bin/umount", str(target)], check=True)
    state_path = STATE_ROOT / f"{mount_name}.json"
    state_path.unlink(missing_ok=True)
    print(json.dumps({
        "status": "unmounted",
        "mount_name": mount_name,
        "mount_path": str(target),
    }, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
